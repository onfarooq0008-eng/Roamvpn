<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+ only hands the advertising ID to apps that declare this. Without it Yandex gets a
         zeroed ID (worse ad fill and measurement). Also what the Play Console "Advertising ID" declaration refers to. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- This app never asks for location or file storage access; it has no
         feature that needs either. These explicit removals are a safety net,
         not a fix for a known problem: they guarantee the Play Console
         permissions declaration stays clean even if a future update to any
         dependency ever merges one of these into the manifest transitively,
         without needing to notice and catch it by hand. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Lets the app see other installed launchable apps for Split Tunneling, WITHOUT
         needing the heavily-scrutinized QUERY_ALL_PACKAGES permission (which Play Store
         requires a special justification form for). This narrower <queries> declaration
         is the modern, Play-Store-friendly approach and needs no extra justification. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:hardwareAccelerated="true"
        android:name=".RoamVpnApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoamVPN"
        tools:replace="android:networkSecurityConfig"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="36">

        <!-- Yandex Mobile Ads must not start by itself: AdsManager starts it only after the user has
             allowed ads (AdsConsent). -->
        <meta-data
            android:name="com.yandex.mobile.ads.AUTOMATIC_SDK_INITIALIZATION"
            android:value="false" />



        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RoamVPN.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.WelcomeActivity" android:exported="false" />
        <activity android:name=".ui.ConsentActivity" android:exported="false" />
        <!-- configChanges: rotating the phone or resizing the window must not recreate this screen, because
             recreating it would cancel a connection attempt that is in progress. The layout scrolls, so it
             adapts by itself. (uiMode is deliberately not listed.) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden" />
        <activity android:name=".ui.PremiumActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.SpeedTestActivity" android:exported="false" />
        <activity android:name=".ui.SplitTunnelActivity" android:exported="false" />

        <!-- Handles the Disconnect button on the persistent "connected" notification. -->
        <receiver android:name=".vpn.VpnActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.roamvpn.ACTION_DISCONNECT" />
            </intent-filter>
        </receiver>

        <!-- REQUIRED by the WireGuard "tunnel" library itself: GoBackend binds to exactly
             this service class name to establish the VPN interface. This is not something
             Gradle merges in automatically from the dependency; it must be declared here
             with this exact name, or the tunnel will never actually connect even though
             the app builds and runs fine otherwise. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
